# ─── Vite Environment ─────────────────────────────────────────────────────────
VITE_ENV=production

# ─── API URL ──────────────────────────────────────────────────────────────────
# For PRODUCTION (Vercel deployment) — point to your Render backend:
VITE_API_URL=https://YOUR_PROJECT_NAME.onrender.com/api

# ─── Socket.IO URL ────────────────────────────────────────────────────────────
# For PRODUCTION — point to your Render backend:
VITE_SOCKET_URL=https://YOUR_PROJECT_NAME.onrender.com

# ─── Vite Dev-Server Proxy Target ─────────────────────────────────────────────
# Only relevant during local development (not used in production builds)
VITE_BACKEND_PROXY_URL=http://localhost:5000
