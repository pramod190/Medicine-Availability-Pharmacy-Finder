# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# ─── MongoDB Atlas ─────────────────────────────────────────────────────────────
# Get from: https://cloud.mongodb.com → your cluster → Connect → Drivers
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/medicine_finder?retryWrites=true&w=majority

# ─── JWT Secret ───────────────────────────────────────────────────────────────
# IMPORTANT: Use a strong random 64-character string in production!
# Generate one at: https://generate-secret.vercel.app/64
JWT_SECRET=REPLACE_WITH_A_64_CHARACTER_RANDOM_STRING

# ─── AI (Gemini) ──────────────────────────────────────────────────────────────
# Get your API key from: https://ai.google.dev/
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# ─── CORS & URLs ───────────────────────────────────────────────────────────────
# Set this to your deployed frontend URL (Vercel URL, no trailing slash)
CLIENT_URL=https://YOUR_PROJECT_NAME.vercel.app

# Backend's own URL (used for reference, set to your Render service URL)
BACKEND_URL=https://YOUR_PROJECT_NAME.onrender.com
